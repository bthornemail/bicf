[0.082274, "o", "\r\n\u001b[1;36m== Ports (stable by-path) ==\u001b[0m\r\nA (NRR)   : /dev/serial/by-path/pci-0000:00:14.0-usb-0:1:1.0-port0\r\nB (VERIFY): /dev/serial/by-path/pci-0000:00:14.0-usb-0:3:1.0-port0\r\nC (ORCH)  : /dev/serial/by-path/pci-0000:00:14.0-usb-0:4:1.0-port0\r\n\r\n\u001b[1;36m== Sanity: devices present ==\u001b[0m\r\n"]
